{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF-IR-05 selected artifact manifest",
  "type": "object",
  "required": [
    "artifact_id",
    "candidate_id",
    "repository",
    "revision",
    "selected_path",
    "quantization",
    "manifest_completeness",
    "shards",
    "local_validation"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "exact_total_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}

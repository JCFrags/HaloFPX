{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halokv:pfir07:key-record:v1",
  "title": "HaloKV key metadata record (no plaintext key material)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key_id",
    "key_type",
    "authority_id",
    "owner_id",
    "principal_scope",
    "namespace_id",
    "epoch_id",
    "purpose",
    "suite",
    "state",
    "created_at",
    "policy_hash"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "key_type": {
      "enum": [
        "authority-root",
        "tenant-root",
        "project-root",
        "prefix-root",
        "namespace-root",
        "rank-root",
        "epoch-root",
        "purpose-key",
        "object-dek",
        "wrapping-key"
      ]
    },
    "parent_key_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "custodian_policy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "principal_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prefix_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "namespace_id": {
      "type": "string",
      "minLength": 1
    },
    "sharing_class": {
      "enum": [
        "private-project",
        "private-tenant",
        "explicit-group",
        "public-system",
        null
      ]
    },
    "rank_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "root",
        "encrypt",
        "private-id",
        "manifest",
        "audit",
        "wrap-object-dek"
      ]
    },
    "suite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "enum": [
        "PREACTIVE",
        "ACTIVE",
        "READ_ONLY",
        "DEACTIVATED",
        "COMPROMISED",
        "DESTROY_PENDING",
        "DESTROYED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "activates_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deactivates_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "compromise_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "destroy_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "escrow_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backup_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "wrapped_key_blob_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "wrapping_key_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  }
}

digraph G {

graph [bgcolor="transparent", pad="0.25", nodesep="0.55", ranksep="0.65", fontname="Inter,Arial"];
node [shape=box, style="rounded,filled", fillcolor="#111827", color="#475569", fontcolor="#e5e7eb", fontname="Inter,Arial", fontsize=11, margin="0.14,0.10"];
edge [color="#22d3ee", fontcolor="#cbd5e1", fontname="Inter,Arial", fontsize=9, penwidth=1.6, arrowsize=0.8];

rankdir=LR;
f [shape=diamond,label="session router",fillcolor="#312e81",color="#818cf8"];
a [label="Replica A\nFull tokenizer/model/sampler\nKV for A-owned sessions"];
b [label="Replica B\nFull tokenizer/model/sampler\nKV for B-owned sessions"];
f -> a [label="session affinity"];
f -> b [label="session affinity"];
a -> b [label="0 model-path bytes",style=dashed,color="#64748b",dir=both];
}

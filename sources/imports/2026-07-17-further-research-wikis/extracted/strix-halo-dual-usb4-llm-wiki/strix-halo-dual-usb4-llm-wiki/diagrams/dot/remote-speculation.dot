digraph G {

graph [bgcolor="transparent", pad="0.25", nodesep="0.55", ranksep="0.65", fontname="Inter,Arial"];
node [shape=box, style="rounded,filled", fillcolor="#111827", color="#475569", fontcolor="#e5e7eb", fontname="Inter,Arial", fontsize=11, margin="0.14,0.10"];
edge [color="#22d3ee", fontcolor="#cbd5e1", fontname="Inter,Arial", fontsize=9, penwidth=1.6, arrowsize=0.8];

rankdir=LR;
a [label="Rank 0\nTokenizer + draft model\nDraft KV + proposal state"];
b [label="Rank 1\nTarget model + target KV\nVerifier + authoritative sampler"];
a -> b [label="γ candidate IDs\n+ q information when exact stochastic",penwidth=2.2];
b -> a [label="accepted count + correction/next token",penwidth=2.2];
n [shape=note,label="Break-even:\nTd(γ)+Tv(γ)+2ℓ+V/B < E[K]·Ttarget,1",fillcolor="#1e293b"];
b -> n [style=dashed,color="#64748b"];
}

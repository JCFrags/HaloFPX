{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node telemetry sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "sample_monotonic_ns",
    "sample_utc",
    "sample_interval_ms",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "sample_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "sample_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sample_interval_ms": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string"
    },
    "cpu": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "memory": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "gpu": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "disk": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "network": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "usb4": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "power": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "thermal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "psi": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "collector_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

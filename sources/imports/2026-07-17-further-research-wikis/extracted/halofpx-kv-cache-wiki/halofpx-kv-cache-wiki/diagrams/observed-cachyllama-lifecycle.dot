rankdir=LR;
a[label="ABSENT"];
b[label="FINAL PATH OPEN
O_TRUNC", fillcolor="#fde8e8", color="#a40e26"];
c[label="HEADER / PAYLOAD
WRITING", fillcolor="#fde8e8", color="#a40e26"];
d[label="HOT RAM"];
e[label="WARM RAM"];
f[label="COLD SSD"];
g[label="EVICTED"];
p[label="CRASH-VISIBLE
PARTIAL", fillcolor="#fff0d6", color="#8a5a00"];

a->b[label="store"]; b->c; c->d[label="close + map"]; d->e[label="demote"]; e->f[label="demote"]; f->d[label="load/promote"]; f->g[label="cold prune"]; d->g; e->g;
b->p[label="crash", style=dashed, color="#a40e26"]; c->p[label="crash", style=dashed, color="#a40e26"]; p->m[label="short read later"];

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki:rocmfpx-persistent-cache-port-plan",
  "title": "Proposed ROCmFPX persistent prompt/KV cache configuration",
  "description": "Recommended target design derived from the retain/redesign/reject assessment; not an existing ROCmFPX interface.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "disabled",
        "run-scoped",
        "persistent"
      ],
      "default": "run-scoped"
    },
    "basePath": {
      "type": "string"
    },
    "ramMiB": {
      "type": "integer",
      "minimum": 0,
      "default": 8192
    },
    "diskMiB": {
      "type": "integer",
      "minimum": 0,
      "default": 8192
    },
    "durability": {
      "enum": [
        "strict",
        "relaxed"
      ],
      "default": "strict"
    },
    "atomicCommit": {
      "const": true,
      "default": true
    },
    "directoryMode": {
      "const": "0700",
      "default": "0700"
    },
    "fileMode": {
      "const": "0600",
      "default": "0600"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelFingerprint": {
          "type": "string",
          "minLength": 16
        },
        "tenantId": {
          "type": "string",
          "description": "Opaque authenticated principal or keyed hash."
        },
        "conversationId": {
          "type": "string"
        }
      },
      "required": [
        "modelFingerprint"
      ]
    },
    "prefixPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 64
        },
        "minimumRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9
        },
        "crossRestart": {
          "type": "boolean",
          "default": true
        },
        "crossConversation": {
          "type": "boolean",
          "default": false
        },
        "systemPrefix": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxUnusedDays": {
          "type": "integer",
          "minimum": 0,
          "default": 30
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxBytesPerTenant": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireAuthenticatedTenantBinding": {
          "const": true,
          "default": true
        },
        "logRawUserIds": {
          "const": false,
          "default": false
        },
        "encryptAtRest": {
          "type": "boolean",
          "default": false
        },
        "allowAnonymousCrossRestartReuse": {
          "const": false,
          "default": false
        }
      },
      "required": [
        "requireAuthenticatedTenantBinding",
        "logRawUserIds",
        "allowAnonymousCrossRestartReuse"
      ]
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enableAuthenticatedApi": {
          "type": "boolean",
          "default": false
        },
        "quarantineCorruptEntries": {
          "type": "boolean",
          "default": true
        },
        "manifestStartupBudgetMs": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        }
      }
    }
  },
  "required": [
    "mode",
    "security"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "persistent"
          }
        }
      },
      "then": {
        "required": [
          "basePath",
          "namespace",
          "prefixPolicy",
          "retention"
        ]
      }
    }
  ]
}

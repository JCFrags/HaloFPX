{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llama-conformance/tolerance-profile.schema.json",
  "title": "Approved tolerance profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "scope",
    "metrics",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "UNCALIBRATED",
        "PROPOSED",
        "APPROVED",
        "RETIRED"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "case_ids",
        "forks",
        "backends",
        "model_sha256",
        "build_family"
      ],
      "properties": {
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_family": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "max_abs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_rel": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_abs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cosine_distance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "top1_must_match": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "top_k_overlap_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "distribution_statistic_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p_value_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "quality_delta_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": [
        "calibration_observations",
        "validation_observations",
        "method",
        "approved_by"
      ],
      "properties": {
        "calibration_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

    string(REPLACE "<PIPE>" "|" RAW_ITEM "${RAW_ITEM}")
    list(APPEND RAW_LINKS "${RAW_ROOT}>${RAW_FROM}>${RAW_ITEM}")
  elseif(NOT RECORD_KIND STREQUAL "target")
    message(FATAL_ERROR "unknown graph manifest record: ${LINE}")

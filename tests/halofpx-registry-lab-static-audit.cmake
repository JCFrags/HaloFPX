  endif()

  execute_process(COMMAND "${DUMPBIN}" /nologo /headers "${CT_OBJECT}"
    RESULT_VARIABLE CT_HEADERS_RC OUTPUT_VARIABLE CT_HEADERS ERROR_VARIABLE CT_HEADERS_ERR)
  if(NOT CT_HEADERS_RC EQUAL 0)
    message(FATAL_ERROR "constant-time COFF header audit failed: ${CT_HEADERS_ERR}")
  endif()
  string(REPLACE "\r\n" "\n" CT_HEADERS "${CT_HEADERS}")
  string(REPLACE ";" "\\;" CT_HEADERS "${CT_HEADERS}")
  string(REPLACE "\n" ";" CT_HEADER_LINES "${CT_HEADERS}")
  set(CT_CURRENT_RAW_SIZE "")
  set(CT_CURRENT_RAW_OFFSET "")

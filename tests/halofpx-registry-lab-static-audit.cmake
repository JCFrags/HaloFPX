  if(RECORD_KIND STREQUAL "edge")
    list(LENGTH FIELDS FIELD_COUNT)
    if(NOT FIELD_COUNT EQUAL 4)
      message(FATAL_ERROR "malformed graph edge record: ${LINE}")
    endif()
    list(GET FIELDS 2 FROM)
    list(GET FIELDS 3 TO)
    list(APPEND EDGES "${FROM}>${TO}")
  elseif(RECORD_KIND STREQUAL "raw")

  list(GET RAW_FIELDS 1 RAW_FROM)
  list(REMOVE_AT RAW_FIELDS 0 1)
  string(JOIN ">" RAW_ITEM ${RAW_FIELDS})
  if(RAW_ROOT STREQUAL "halofpx-context-store-registry-lab-wire" OR
     RAW_ROOT STREQUAL "halofpx-context-store-registry-lab-read-only")
    message(FATAL_ERROR "registry-lab closure contains unallowlisted raw link item: ${RAW_ROOT}: ${RAW_FROM} -> ${RAW_ITEM}")
  endif()
  raw_link_is_harmless("${RAW_ITEM}" RAW_HARMLESS)
  if(NOT RAW_HARMLESS)
    message(FATAL_ERROR "product reverse proof cannot traverse raw link item: ${RAW_ROOT}: ${RAW_FROM} -> ${RAW_ITEM}")
  endif()
endforeach()

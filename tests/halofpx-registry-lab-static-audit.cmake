  execute_process(COMMAND "${LIB_TOOL}" /nologo "/extract:${CT_MEMBER}" "/out:${CT_OBJECT}" "${CT_ARCHIVE}"
    RESULT_VARIABLE CT_EXTRACT_RC OUTPUT_VARIABLE CT_EXTRACT_OUT ERROR_VARIABLE CT_EXTRACT_ERR)
  if(NOT CT_EXTRACT_RC EQUAL 0 OR NOT EXISTS "${CT_OBJECT}")

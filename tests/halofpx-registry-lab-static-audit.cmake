function(find_forbidden_symbol TEXT OUT_VAR)
  string(TOLOWER "${TEXT}" TEXT_LOWER)
  set(FOUND "")
  foreach(FORBIDDEN IN LISTS FORBIDDEN_SYMBOLS)
    string(TOLOWER "${FORBIDDEN}" FORBIDDEN_LOWER)
    string(FIND "${TEXT_LOWER}" "${FORBIDDEN_LOWER}" HIT)
    if(NOT HIT EQUAL -1)
      set(FOUND "${FORBIDDEN}")
      break()
    endif()
  endforeach()
  set(${OUT_VAR} "${FOUND}" PARENT_SCOPE)
endfunction()
find_forbidden_symbol("UNDEF External | __imp_CreateFileW" SYNTHETIC_FORBIDDEN)
if(NOT SYNTHETIC_FORBIDDEN STREQUAL "CreateFile")
  message(FATAL_ERROR "forbidden-symbol detector synthetic positive self-test failed")

endif()
function(find_allocator_import TEXT OUT_VAR)
  string(REPLACE "\r\n" "\n" NORMALIZED_TEXT "${TEXT}")
  string(REPLACE "\n" ";" SYMBOL_LINES "${NORMALIZED_TEXT}")
  set(FOUND "")
  foreach(SYMBOL_LINE IN LISTS SYMBOL_LINES)
    string(TOLOWER "${SYMBOL_LINE}" SYMBOL_LINE_LOWER)
    if(SYMBOL_LINE_LOWER MATCHES "undef.*external" AND
       SYMBOL_LINE_LOWER MATCHES "(^|[^a-z0-9_])(malloc|calloc|realloc|operator new)([^a-z0-9_]|$)")
      set(FOUND "${SYMBOL_LINE}")
      break()
    endif()
  endforeach()
  set(${OUT_VAR} "${FOUND}" PARENT_SCOPE)
endfunction()
find_allocator_import("UNDEF notype () External | operator new(unsigned __int64)" SYNTHETIC_ALLOCATOR)
if(SYNTHETIC_ALLOCATOR STREQUAL "")

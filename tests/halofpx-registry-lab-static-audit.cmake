  if(NOT LIB_RC EQUAL 0 OR NOT MEMBERS MATCHES "\\.obj([\r\n]|$)")
    message(FATAL_ERROR "invalid/empty archive member inventory ${ARCHIVE}: ${LIB_ERR}${MEMBERS}")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo /symbols /undecorate "${ARCHIVE}"
    RESULT_VARIABLE SYMBOL_RC OUTPUT_VARIABLE SYMBOLS ERROR_VARIABLE SYMBOL_ERR)
  if(NOT SYMBOL_RC EQUAL 0)
    message(FATAL_ERROR "dumpbin symbol audit failed for ${ARCHIVE}: ${SYMBOL_ERR}")
  endif()
  find_forbidden_symbol("${SYMBOLS}" ARCHIVE_FORBIDDEN)
  if(NOT ARCHIVE_FORBIDDEN STREQUAL "")
    message(FATAL_ERROR "forbidden symbol ${ARCHIVE_FORBIDDEN} in ${ARCHIVE}")
  endif()
  if(ARCHIVE MATCHES "halofpx-context-store-registry-lab-read-only")
    find_allocator_import("${SYMBOLS}" ARCHIVE_ALLOCATOR)
    if(NOT ARCHIVE_ALLOCATOR STREQUAL "")
      message(FATAL_ERROR "allocator import in allocation-free read-only archive ${ARCHIVE}: ${ARCHIVE_ALLOCATOR}")
    endif()
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo /directives "${ARCHIVE}"
    RESULT_VARIABLE DIRECTIVE_RC OUTPUT_VARIABLE DIRECTIVES ERROR_VARIABLE DIRECTIVE_ERR)
  if(NOT DIRECTIVE_RC EQUAL 0)
    message(FATAL_ERROR "dumpbin directive audit failed for ${ARCHIVE}: ${DIRECTIVE_ERR}")
  endif()
  string(REGEX MATCHALL "/DEFAULTLIB:[^ \r\n]+" DEFAULT_LIBS "${DIRECTIVES}")
  foreach(DEFAULT_LIB IN LISTS DEFAULT_LIBS)
    string(REGEX REPLACE "^/DEFAULTLIB:" "" DEFAULT_NAME "${DEFAULT_LIB}")
    string(TOLOWER "${DEFAULT_NAME}" DEFAULT_NAME)
    if(NOT DEFAULT_NAME MATCHES "^(msvcprt|msvcprtd|msvcrt|msvcrtd|libcmt|libcmtd|vcruntime|vcruntimed|ucrt|ucrtd|oldnames)$")
      message(FATAL_ERROR "unexpected default/import library ${DEFAULT_NAME} in ${ARCHIVE}")
    endif()
  endforeach()
endforeach()

# The authentication decision is intentionally isolated into a fixed-width
# noinline comparator. For production-like MSVC builds, bind its exact COFF
# COMDAT section to an independently reviewed machine-code body. This is a
# fail-closed optimizer audit: a toolchain or code-generation change requires
# explicit re-review instead of silently broadening accepted branch shapes.
if(CONFIG STREQUAL "Release")
  set(CT_SYMBOL "halofpx_registry_lab_constant_time_tag_equal_32")
  set(CT_EXPECTED_BYTES
    "C64424180033C0660F1F840000000000440FB64C2418440FB604024432040148FFC0450AC144884424184883F82072E00FB644241884C00F94C0C3")

  function(ct_body_admitted BODY OUT_VAR)
    string(TOUPPER "${BODY}" BODY_UPPER)
    if(BODY_UPPER STREQUAL CT_EXPECTED_BYTES)
      set(${OUT_VAR} TRUE PARENT_SCOPE)
    else()
      set(${OUT_VAR} FALSE PARENT_SCOPE)
    endif()
  endfunction()
  ct_body_admitted("${CT_EXPECTED_BYTES}" CT_SYNTHETIC_GOOD)
  if(NOT CT_SYNTHETIC_GOOD)
    message(FATAL_ERROR "constant-time body detector rejected its reviewed positive control")
  endif()
  ct_body_admitted("${CT_EXPECTED_BYTES}75" CT_SYNTHETIC_EXTRA_BRANCH)
  if(CT_SYNTHETIC_EXTRA_BRANCH)
    message(FATAL_ERROR "constant-time body detector admitted a synthetic extra branch")
  endif()
  string(REGEX REPLACE "20" "1F" CT_WRONG_BOUND "${CT_EXPECTED_BYTES}")
  ct_body_admitted("${CT_WRONG_BOUND}" CT_SYNTHETIC_WRONG_BOUND)
  if(CT_SYNTHETIC_WRONG_BOUND)

foreach(REQUIRED IN ITEMS BUILD_ROOT CONFIG GRAPH_MANIFEST ARCHIVE_MANIFEST DUMPBIN LIB_TOOL)
  if(NOT DEFINED ${REQUIRED})
    message(FATAL_ERROR "static audit missing ${REQUIRED}")
  endif()
endforeach()

execute_process(
  COMMAND "${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config "${CONFIG}"
          --target halofpx-registry-lab-static-audit-inputs
  RESULT_VARIABLE BUILD_RC OUTPUT_VARIABLE BUILD_OUT ERROR_VARIABLE BUILD_ERR)
if(NOT BUILD_RC EQUAL 0)
  message(FATAL_ERROR "failed to build static-audit inputs:\n${BUILD_OUT}\n${BUILD_ERR}")
endif()

file(STRINGS "${GRAPH_MANIFEST}" GRAPH_LINES)
set(EXPECTED_CLOSURE
  halofpx-context-store-registry-lab-wire
  halofpx-context-store-registry-successor
  halofpx-context-store-protected-registry
  halofpx-context-store-auth
  halofpx-context-store-format
  halofpx-context-store-sha256)

foreach(LINE IN LISTS GRAPH_LINES)
  if(LINE MATCHES "^#")
    continue()
  endif()
  string(REPLACE "|" ";" FIELDS "${LINE}")
  list(GET FIELDS 0 RECORD_KIND)
  if(RECORD_KIND STREQUAL "edge")
    list(LENGTH FIELDS FIELD_COUNT)
    if(NOT FIELD_COUNT EQUAL 4)
      message(FATAL_ERROR "malformed graph edge record: ${LINE}")
    endif()
    list(GET FIELDS 2 FROM)
    list(GET FIELDS 3 TO)
    list(APPEND EDGES "${FROM}>${TO}")
  elseif(RECORD_KIND STREQUAL "raw")
    list(LENGTH FIELDS FIELD_COUNT)
    if(NOT FIELD_COUNT EQUAL 4)
      message(FATAL_ERROR "malformed graph raw-link record: ${LINE}")
    endif()
    list(GET FIELDS 1 RAW_ROOT)
    list(GET FIELDS 2 RAW_FROM)
    list(GET FIELDS 3 RAW_ITEM)
    string(REPLACE "<PIPE>" "|" RAW_ITEM "${RAW_ITEM}")
    list(APPEND RAW_LINKS "${RAW_ROOT}>${RAW_FROM}>${RAW_ITEM}")
  elseif(NOT RECORD_KIND STREQUAL "target")
    message(FATAL_ERROR "unknown graph manifest record: ${LINE}")
  endif()
endforeach()
list(REMOVE_DUPLICATES EDGES)

set(CLOSURE halofpx-context-store-registry-lab-wire)
set(CHANGED TRUE)
while(CHANGED)
  set(CHANGED FALSE)
  foreach(EDGE IN LISTS EDGES)
    string(REPLACE ">" ";" PAIR "${EDGE}")
    list(GET PAIR 0 FROM)
    list(GET PAIR 1 TO)
    if(FROM IN_LIST CLOSURE AND NOT TO IN_LIST CLOSURE)
      list(APPEND CLOSURE "${TO}")
      set(CHANGED TRUE)
    endif()
  endforeach()
endwhile()
list(SORT CLOSURE)
list(SORT EXPECTED_CLOSURE)
if(NOT CLOSURE STREQUAL EXPECTED_CLOSURE)
  message(FATAL_ERROR "unexpected registry-lab dependency closure: ${CLOSURE}; expected ${EXPECTED_CLOSURE}")
endif()
function(raw_link_is_harmless ITEM OUT_VAR)
  # These are terminal platform linker inputs, not archives or project code.
  if(ITEM MATCHES "^(-pthread|pthread|-ldl|dl|-lm|m|-lrt|rt|-latomic|atomic|ws2_32|bcrypt|OpenMP::OpenMP_C|OpenMP::OpenMP_CXX)$")
    set(${OUT_VAR} TRUE PARENT_SCOPE)
  else()
    set(${OUT_VAR} FALSE PARENT_SCOPE)
  endif()
endfunction()
foreach(RAW_LINK IN LISTS RAW_LINKS)
  string(REPLACE ">" ";" RAW_FIELDS "${RAW_LINK}")
  list(GET RAW_FIELDS 0 RAW_ROOT)
  list(GET RAW_FIELDS 1 RAW_FROM)
  list(REMOVE_AT RAW_FIELDS 0 1)
  string(JOIN ">" RAW_ITEM ${RAW_FIELDS})
  if(RAW_ROOT STREQUAL "halofpx-context-store-registry-lab-wire")
    message(FATAL_ERROR "wire closure contains unallowlisted raw link item: ${RAW_FROM} -> ${RAW_ITEM}")
  endif()
  raw_link_is_harmless("${RAW_ITEM}" RAW_HARMLESS)
  if(NOT RAW_HARMLESS)
    message(FATAL_ERROR "product reverse proof cannot traverse raw link item: ${RAW_ROOT}: ${RAW_FROM} -> ${RAW_ITEM}")
  endif()
endforeach()
foreach(PRODUCT IN ITEMS server-context llama-server llama-cli)
  set(REACHABLE "${PRODUCT}")
  set(CHANGED TRUE)
  while(CHANGED)
    set(CHANGED FALSE)
    foreach(EDGE IN LISTS EDGES)
      string(REPLACE ">" ";" PAIR "${EDGE}")
      list(GET PAIR 0 FROM)
      list(GET PAIR 1 TO)
      if(FROM IN_LIST REACHABLE AND NOT TO IN_LIST REACHABLE)
        list(APPEND REACHABLE "${TO}")
        set(CHANGED TRUE)
      endif()
    endforeach()
  endwhile()
  if(halofpx-context-store-registry-lab-wire IN_LIST REACHABLE)
    message(FATAL_ERROR "product ${PRODUCT} links back to registry-lab wire")
  endif()
endforeach()
# Synthetic detector self-tests: unknown closure members and unknown product
# intermediates must not disappear merely because they were not pre-enumerated.
set(SYNTHETIC_WIRE_CLOSURE ${EXPECTED_CLOSURE} halofpx-unexpected-intermediate)
list(SORT SYNTHETIC_WIRE_CLOSURE)
if(SYNTHETIC_WIRE_CLOSURE STREQUAL EXPECTED_CLOSURE)
  message(FATAL_ERROR "unknown dependency detector synthetic self-test failed")
endif()
set(SYNTHETIC_PRODUCT_EDGES
  "server-context>halofpx-unexpected-intermediate"
  "halofpx-unexpected-intermediate>halofpx-context-store-registry-lab-wire")
set(SYNTHETIC_REACHABLE server-context)
set(SYNTHETIC_CHANGED TRUE)
while(SYNTHETIC_CHANGED)
  set(SYNTHETIC_CHANGED FALSE)
  foreach(EDGE IN LISTS SYNTHETIC_PRODUCT_EDGES)
    string(REPLACE ">" ";" PAIR "${EDGE}")
    list(GET PAIR 0 FROM)
    list(GET PAIR 1 TO)
    if(FROM IN_LIST SYNTHETIC_REACHABLE AND NOT TO IN_LIST SYNTHETIC_REACHABLE)
      list(APPEND SYNTHETIC_REACHABLE "${TO}")
      set(SYNTHETIC_CHANGED TRUE)
    endif()
  endforeach()
endwhile()
if(NOT halofpx-context-store-registry-lab-wire IN_LIST SYNTHETIC_REACHABLE)
  message(FATAL_ERROR "unknown product-intermediate detector synthetic self-test failed")
endif()
raw_link_is_harmless("C:/tmp/halofpx-context-store-bootstrap-material.lib" SYNTHETIC_RAW_SAFE)
if(SYNTHETIC_RAW_SAFE)
  message(FATAL_ERROR "raw archive bypass detector synthetic self-test failed")
endif()
raw_link_is_harmless("-Wl,C:/tmp/halofpx-context-store-registry-lab-wire.a" SYNTHETIC_RAW_LEAK_SAFE)
if(SYNTHETIC_RAW_LEAK_SAFE)
  message(FATAL_ERROR "raw product-link bypass detector synthetic self-test failed")
endif()
raw_link_is_harmless("-pthread" SYNTHETIC_SYSTEM_SAFE)
if(NOT SYNTHETIC_SYSTEM_SAFE)
  message(FATAL_ERROR "harmless raw system-link classifier self-test failed")
endif()

include("${ARCHIVE_MANIFEST}")
list(LENGTH HALOFPX_REGISTRY_LAB_ARCHIVES ARCHIVE_COUNT)
if(NOT ARCHIVE_COUNT EQUAL 6)
  message(FATAL_ERROR "archive manifest must contain exactly six closure archives")
endif()
set(FORBIDDEN_SYMBOLS
  "concrete_registry_lab_observation" "bootstrap_material" "bootstrap_anchor"
  "context_store_publication" "context_store_cache"
  "context_store_restore" "llama-ai" "CachyLLama" "CreateFile" "ReadFile"
  "WriteFile" "MoveFile" "DeleteFile" "openat" "fsync" "fdatasync"
  "RegOpenKey" "WSAStartup")
function(find_forbidden_symbol TEXT OUT_VAR)
  string(TOLOWER "${TEXT}" TEXT_LOWER)
  set(FOUND "")
  foreach(FORBIDDEN IN LISTS FORBIDDEN_SYMBOLS)
    string(TOLOWER "${FORBIDDEN}" FORBIDDEN_LOWER)
    string(FIND "${TEXT_LOWER}" "${FORBIDDEN_LOWER}" HIT)
    if(NOT HIT EQUAL -1)
      set(FOUND "${FORBIDDEN}")
      break()
    endif()
  endforeach()
  set(${OUT_VAR} "${FOUND}" PARENT_SCOPE)
endfunction()
find_forbidden_symbol("UNDEF External | __imp_CreateFileW" SYNTHETIC_FORBIDDEN)
if(NOT SYNTHETIC_FORBIDDEN STREQUAL "CreateFile")
  message(FATAL_ERROR "forbidden-symbol detector synthetic positive self-test failed")
endif()
find_forbidden_symbol("UNDEF External | memcpy" SYNTHETIC_BENIGN)
if(NOT SYNTHETIC_BENIGN STREQUAL "")
  message(FATAL_ERROR "forbidden-symbol detector benign self-test failed")
endif()
foreach(ARCHIVE IN LISTS HALOFPX_REGISTRY_LAB_ARCHIVES)
  if(NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "missing closure archive: ${ARCHIVE}")
  endif()
  execute_process(COMMAND "${LIB_TOOL}" /nologo /list "${ARCHIVE}"
    RESULT_VARIABLE LIB_RC OUTPUT_VARIABLE MEMBERS ERROR_VARIABLE LIB_ERR)
  if(NOT LIB_RC EQUAL 0 OR NOT MEMBERS MATCHES "\\.obj([\r\n]|$)")
    message(FATAL_ERROR "invalid/empty archive member inventory ${ARCHIVE}: ${LIB_ERR}${MEMBERS}")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo /symbols /undecorate "${ARCHIVE}"
    RESULT_VARIABLE SYMBOL_RC OUTPUT_VARIABLE SYMBOLS ERROR_VARIABLE SYMBOL_ERR)
  if(NOT SYMBOL_RC EQUAL 0)
    message(FATAL_ERROR "dumpbin symbol audit failed for ${ARCHIVE}: ${SYMBOL_ERR}")
  endif()
  find_forbidden_symbol("${SYMBOLS}" ARCHIVE_FORBIDDEN)
  if(NOT ARCHIVE_FORBIDDEN STREQUAL "")
    message(FATAL_ERROR "forbidden symbol ${ARCHIVE_FORBIDDEN} in ${ARCHIVE}")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo /directives "${ARCHIVE}"
    RESULT_VARIABLE DIRECTIVE_RC OUTPUT_VARIABLE DIRECTIVES ERROR_VARIABLE DIRECTIVE_ERR)
  if(NOT DIRECTIVE_RC EQUAL 0)
    message(FATAL_ERROR "dumpbin directive audit failed for ${ARCHIVE}: ${DIRECTIVE_ERR}")
  endif()
  string(REGEX MATCHALL "/DEFAULTLIB:[^ \r\n]+" DEFAULT_LIBS "${DIRECTIVES}")
  foreach(DEFAULT_LIB IN LISTS DEFAULT_LIBS)
    string(REGEX REPLACE "^/DEFAULTLIB:" "" DEFAULT_NAME "${DEFAULT_LIB}")
    string(TOLOWER "${DEFAULT_NAME}" DEFAULT_NAME)
    if(NOT DEFAULT_NAME MATCHES "^(msvcprt|msvcprtd|msvcrt|msvcrtd|libcmt|libcmtd|vcruntime|vcruntimed|ucrt|ucrtd|oldnames)$")
      message(FATAL_ERROR "unexpected default/import library ${DEFAULT_NAME} in ${ARCHIVE}")
    endif()
  endforeach()
endforeach()
message(STATUS "PASS: exact graph closure, product exclusion, and Windows archive audit")

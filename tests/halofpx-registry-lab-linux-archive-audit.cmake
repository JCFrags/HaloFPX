function(assert_clean_symbols TEXT LABEL)
  string(TOLOWER "${TEXT}" TEXT_LOWER)
  foreach(FORBIDDEN IN LISTS FORBIDDEN_SYMBOLS)
    string(TOLOWER "${FORBIDDEN}" FORBIDDEN_LOWER)
    string(FIND "${TEXT_LOWER}" "${FORBIDDEN_LOWER}" HIT)
    if(NOT HIT EQUAL -1)
      message(FATAL_ERROR "forbidden Linux symbol ${FORBIDDEN} in ${LABEL}")
    endif()
  endforeach()
  string(REPLACE "\r\n" "\n" NORMALIZED_TEXT "${TEXT}")
  string(REPLACE "\n" ";" SYMBOL_LINES "${NORMALIZED_TEXT}")
  foreach(SYMBOL_LINE IN LISTS SYMBOL_LINES)
    if(SYMBOL_LINE MATCHES "(^|[ \t])(U|UND)([ \t])" AND
       SYMBOL_LINE MATCHES "(^|[^A-Za-z0-9_])(openat|fsync|fdatasync|rename|unlink|getenv|system)(@[^ \t]*)?($|[^A-Za-z0-9_])")
      message(FATAL_ERROR "forbidden Linux undefined OS symbol in ${LABEL}: ${SYMBOL_LINE}")
    endif()
  endforeach()
endfunction()

function(find_allocator_import TEXT OUT_VAR)
  string(REPLACE "\r\n" "\n" NORMALIZED_TEXT "${TEXT}")
  string(REPLACE "\n" ";" SYMBOL_LINES "${NORMALIZED_TEXT}")
  set(FOUND "")
  foreach(SYMBOL_LINE IN LISTS SYMBOL_LINES)
    string(TOLOWER "${SYMBOL_LINE}" SYMBOL_LINE_LOWER)
    if(SYMBOL_LINE_LOWER MATCHES "(^|[ \\t])(u|und)([ \\t])" AND
       SYMBOL_LINE_LOWER MATCHES "(^|[^a-z0-9_])(malloc|calloc|realloc|operator new)([^a-z0-9_]|$)")
      set(FOUND "${SYMBOL_LINE}")
      break()
    endif()
  endforeach()
  set(${OUT_VAR} "${FOUND}" PARENT_SCOPE)
endfunction()

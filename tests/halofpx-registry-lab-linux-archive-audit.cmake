set(OBJECT_ROOT "${BUILD_ROOT}/halofpx-registry-lab-linux-object-audit/${CONFIG}")
file(MAKE_DIRECTORY "${OBJECT_ROOT}")
set(ARCHIVE_INDEX 0)
foreach(ARCHIVE IN LISTS ALL_REGISTRY_LAB_ARCHIVES)
  if(NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "missing Linux closure archive: ${ARCHIVE}")
  endif()
  execute_process(COMMAND "${AR_TOOL}" t "${ARCHIVE}"
    RESULT_VARIABLE AR_RC OUTPUT_VARIABLE MEMBERS ERROR_VARIABLE AR_ERR)
  if(NOT AR_RC EQUAL 0)
    message(FATAL_ERROR "ar inventory failed for ${ARCHIVE}: ${AR_ERR}")
  endif()
  string(REGEX REPLACE "[\r\n]+" ";" MEMBER_LIST "${MEMBERS}")
  list(FILTER MEMBER_LIST EXCLUDE REGEX "^$")
  if(NOT MEMBER_LIST)
    message(FATAL_ERROR "empty Linux closure archive: ${ARCHIVE}")
  endif()
  execute_process(COMMAND "${NM_TOOL}" -A -u -C "${ARCHIVE}"
    RESULT_VARIABLE NM_RC OUTPUT_VARIABLE NM_UNDEFINED ERROR_VARIABLE NM_ERR)
  if(NOT NM_RC EQUAL 0)
    message(FATAL_ERROR "nm undefined-symbol audit failed for ${ARCHIVE}: ${NM_ERR}")
  endif()
  assert_clean_symbols("${NM_UNDEFINED}" "${ARCHIVE} undefined symbols")
  if(ARCHIVE MATCHES "halofpx-context-store-registry-lab-read-only")
    find_allocator_import("${NM_UNDEFINED}" ARCHIVE_ALLOCATOR)
    if(NOT ARCHIVE_ALLOCATOR STREQUAL "")
      message(FATAL_ERROR "allocator import in allocation-free Linux read-only archive ${ARCHIVE}: ${ARCHIVE_ALLOCATOR}")
    endif()
  endif()
  execute_process(COMMAND "${NM_TOOL}" -A --defined-only -C "${ARCHIVE}"
    RESULT_VARIABLE NM_DEFINED_RC OUTPUT_VARIABLE NM_DEFINED ERROR_VARIABLE NM_DEFINED_ERR)
  if(NOT NM_DEFINED_RC EQUAL 0)
    message(FATAL_ERROR "nm defined-symbol audit failed for ${ARCHIVE}: ${NM_DEFINED_ERR}")
  endif()
  assert_clean_symbols("${NM_DEFINED}" "${ARCHIVE} defined symbols")
  set(MEMBER_INDEX 0)
  foreach(MEMBER IN LISTS MEMBER_LIST)
    set(OBJECT_FILE "${OBJECT_ROOT}/archive-${ARCHIVE_INDEX}-member-${MEMBER_INDEX}.o")
    execute_process(COMMAND "${AR_TOOL}" p "${ARCHIVE}" "${MEMBER}"
      RESULT_VARIABLE EXTRACT_RC OUTPUT_FILE "${OBJECT_FILE}" ERROR_VARIABLE EXTRACT_ERR)
    if(NOT EXTRACT_RC EQUAL 0)
      message(FATAL_ERROR "ar member extraction failed for ${ARCHIVE}(${MEMBER}): ${EXTRACT_ERR}")
    endif()
    execute_process(COMMAND "${READELF_TOOL}" -Ws "${OBJECT_FILE}"
      RESULT_VARIABLE ELF_RC OUTPUT_VARIABLE ELF_SYMBOLS ERROR_VARIABLE ELF_ERR)
    if(NOT ELF_RC EQUAL 0 OR NOT ELF_SYMBOLS MATCHES "Symbol table")
      message(FATAL_ERROR "readelf symbol audit failed for ${ARCHIVE}(${MEMBER}): ${ELF_ERR}")
    endif()
    assert_clean_symbols("${ELF_SYMBOLS}" "${ARCHIVE}(${MEMBER}) ELF symbols")
    execute_process(COMMAND "${READELF_TOOL}" -d "${OBJECT_FILE}"
      RESULT_VARIABLE DYNAMIC_RC OUTPUT_VARIABLE DYNAMIC_TEXT ERROR_VARIABLE DYNAMIC_ERR)
    if(NOT DYNAMIC_RC EQUAL 0)
      message(FATAL_ERROR "readelf dynamic audit failed for ${ARCHIVE}(${MEMBER}): ${DYNAMIC_ERR}")
    endif()
    if(DYNAMIC_TEXT MATCHES "\\(NEEDED\\)|\\(SONAME\\)")
      message(FATAL_ERROR "relocatable audit object contains a dynamic import/SONAME: ${ARCHIVE}(${MEMBER})")
    endif()
    math(EXPR MEMBER_INDEX "${MEMBER_INDEX} + 1")
  endforeach()
  math(EXPR ARCHIVE_INDEX "${ARCHIVE_INDEX} + 1")
endforeach()
message(STATUS "PASS: Linux ar/nm/readelf archive and member-object audit")

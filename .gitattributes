* text=auto
.gitattributes text eol=lf

# Evidence manifests and executable text must be byte-stable across clones.
SHA256SUMS text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve the imported terminal artifacts byte-for-byte. The v02 ledger has
# original CRLF line endings; the Markdown receipt has one intentional hard
# line break represented by two trailing spaces.
docs/halofpx/evidence/fresh-pc-recovery/**/2026-08-12__halofpx-same-pc-full-recovery__sha256-ledger__v02.txt binary
docs/halofpx/evidence/fresh-pc-recovery/**/2026-08-12__halofpx-same-pc-full-recovery__receipt__open-v01.md whitespace=-trailing-space

# Preserve pinned third-party source prose verbatim, including its whitespace.
docs/halofpx/fixtures/qwen3-0.6b-rocmfpx/source-distribution-README-28675487.md -diff

# Preserve the raw target incident journals exactly as captured.
docs/halofpx/evidence/2026-08-12-target-hmm-oom-incident/raw/*.log binary

# Preserve binary evidence and archives exactly.
*.bin binary
*.bundle binary
*.gguf binary
*.jar binary
*.pdf binary
*.st binary
*.tar binary
*.zip binary

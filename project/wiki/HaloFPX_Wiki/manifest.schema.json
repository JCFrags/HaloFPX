{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halofpx.local/schemas/wiki-manifest-1.0.json",
  "title": "HaloFPX Wiki canonical path manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "wiki_name",
    "authority_scope",
    "generated_on",
    "registry",
    "schema",
    "generator",
    "input_digest_sha256",
    "planned_category_count",
    "planned_section_count",
    "categories"
  ],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "wiki_name": { "const": "HaloFPX LLM Wiki" },
    "authority_scope": { "const": "canonical section paths and structural artifact state" },
    "generated_on": { "type": "string", "minLength": 1 },
    "registry": { "const": "../../research/prompts/section_index.yaml" },
    "schema": { "const": "manifest.schema.json" },
    "generator": { "const": "../../research/prompts/tools/generate_wiki_manifest.py" },
    "input_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "planned_category_count": { "type": "integer", "minimum": 1 },
    "planned_section_count": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"], "minimum": 0 },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "title", "canonical_path", "sections", "artifact_state", "section_count"],
      "properties": {
        "category_id": { "type": "string", "pattern": "^[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "canonical_path": { "type": "string", "pattern": "^[0-9]{2}_[^/]+$" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "artifact_state": { "enum": ["complete", "incomplete"] },
        "section_count": { "type": "integer", "minimum": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "canonical_path",
        "section_manifest",
        "artifact_state",
        "missing_required_files",
        "metadata_state",
        "metadata_errors",
        "declared_status",
        "last_verified",
        "source_count",
        "open_question_count"
      ],
      "properties": {
        "section_id": { "type": "string", "pattern": "^[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "canonical_path": { "type": "string", "pattern": "^[0-9]{2}_[^/]+/[0-9]{2}_[^/]+$" },
        "section_manifest": { "type": "string", "pattern": "^[^/]+/[^/]+/section\\.yaml$" },
        "artifact_state": { "enum": ["complete", "incomplete", "missing"] },
        "missing_required_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metadata_state": { "enum": ["valid", "invalid"] },
        "metadata_errors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "declared_status": { "$ref": "#/$defs/nullableString" },
        "last_verified": { "$ref": "#/$defs/nullableString" },
        "source_count": { "$ref": "#/$defs/nullableInteger" },
        "open_question_count": { "$ref": "#/$defs/nullableInteger" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault injection event and recovery record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "fault_event_id",
    "fault_matrix_id",
    "target",
    "phase",
    "planned_at_monotonic_ns",
    "action",
    "rollback",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "fault_event_id": {
      "type": "string"
    },
    "fault_matrix_id": {
      "type": "string",
      "pattern": "^F-[A-Z]+-[0-9]{3}$"
    },
    "target": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "planned_at_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "actual_start_monotonic_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actual_end_monotonic_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "action": {
      "type": "object",
      "required": [
        "type",
        "parameters"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": [
        "method",
        "verified"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "verified_at_monotonic_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": [
        "detected",
        "silent_corruption",
        "passed"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "detection_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "service_recovery_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "failed_requests": {
          "type": "integer",
          "minimum": 0
        },
        "lost_acknowledged_requests": {
          "type": "integer",
          "minimum": 0
        },
        "silent_corruption": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "operator": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

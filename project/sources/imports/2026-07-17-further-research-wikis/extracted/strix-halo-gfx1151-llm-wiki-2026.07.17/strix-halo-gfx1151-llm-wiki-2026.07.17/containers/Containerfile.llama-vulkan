# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=fedora:43
FROM ${BASE_IMAGE} AS build
ARG LLAMA_COMMIT=86d86ed4396b4130922f7b9af26e3d9fc11a591b
RUN dnf install -y \
      cmake gcc-c++ git glslc libcurl-devel ninja-build openssl-devel \
      spirv-tools vulkan-headers vulkan-loader-devel && \
    dnf clean all
WORKDIR /src
RUN git clone --filter=blob:none https://github.com/ggml-org/llama.cpp.git && \
    cd llama.cpp && git fetch --depth=1 origin ${LLAMA_COMMIT} && \
    git checkout --detach ${LLAMA_COMMIT}
WORKDIR /src/llama.cpp
RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_VULKAN=ON \
      -DGGML_HIP=OFF \
      -DGGML_CUDA=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DGGML_BUILD_TESTS=OFF && \
    cmake --build build -j"$(nproc)" && \
    printf 'llama_commit=%s\nbackend=Vulkan\n' "${LLAMA_COMMIT}" \
      > build/bin/STRIX_BUILD_PROVENANCE.txt

FROM ${BASE_IMAGE} AS runtime
RUN dnf install -y \
      libcurl libgomp mesa-vulkan-drivers openssl-libs vulkan-loader vulkan-tools && \
    dnf clean all
COPY --from=build /src/llama.cpp/build/bin/ /opt/llama/bin/
ENV PATH=/opt/llama/bin:${PATH}
WORKDIR /work
LABEL org.opencontainers.image.description="Pinned llama.cpp Vulkan build with Fedora RADV runtime; host kernel and firmware remain external"
CMD ["llama-cli", "--help"]

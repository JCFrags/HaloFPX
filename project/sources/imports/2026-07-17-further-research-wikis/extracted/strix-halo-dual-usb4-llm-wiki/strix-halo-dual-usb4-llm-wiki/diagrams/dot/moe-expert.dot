digraph G {

graph [bgcolor="transparent", pad="0.25", nodesep="0.55", ranksep="0.65", fontname="Inter,Arial"];
node [shape=box, style="rounded,filled", fillcolor="#111827", color="#475569", fontcolor="#e5e7eb", fontname="Inter,Arial", fontsize=11, margin="0.14,0.10"];
edge [color="#22d3ee", fontcolor="#cbd5e1", fontname="Inter,Arial", fontsize=9, penwidth=1.6, arrowsize=0.8];

rankdir=LR;
a [label="Rank 0\nAttention + router + KV\nLocal experts E_A\nSampler"];
b [label="Rank 1\nRemote expert service E_B\nNo KV / no sampler"];
a -> b [label="dispatch Rₗ hidden vectors\nRₗ=Nₗ·k·ρₗ",penwidth=2.2];
b -> a [label="return Rₗ expert outputs",penwidth=2.2];
n [shape=note,label="Per MoE layer cross-cut:\nRₗ·(2h·bₐ+bmeta)\nTwo communication phases",fillcolor="#1e293b"];
a -> n [style=dashed,color="#64748b"];
}
